# Kopieren nach .env und anpassen. Die Datei .env niemals ins Repository einchecken.

# Langes, zufälliges Passwort für PostgreSQL (z. B. openssl rand -base64 32)
POSTGRES_PASSWORD=bitte-aendern

# Image-Version: latest oder eine feste Version wie 0.1.0
MYLIFE_VERSION=latest

# Port auf der Synology, an den der Nginx Proxy Manager weiterleitet
MYLIFE_PORT=8080

# Ablage aller Daten (Datenbank, Dokumente, Schlüssel, Sicherungen) – dieses Verzeichnis sichert das Synology-Backup
MYLIFE_DATA_DIR=./data

TZ=Europe/Berlin
