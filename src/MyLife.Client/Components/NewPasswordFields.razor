@* Neues Master-Passwort mit Wiederholung und Stärkeanzeige. Die Felder melden sich beim umgebenden MudForm an. *@
@inject IStringLocalizer<SharedResource> L

<MudTextField T="string" Value="Password" ValueChanged="OnPasswordChanged" Label="@(Label ?? L["SetupPassword"])"
              HelperText="@L["SetupPasswordHelp", SetupLimits.MinPasswordLength]" Variant="Variant.Outlined"
              InputType="@(_show ? InputType.Text : InputType.Password)" Immediate AutoFocus="AutoFocus"
              Adornment="Adornment.End" AdornmentIcon="@(_show ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
              AdornmentAriaLabel="@L["SetupShowPassword"]" OnAdornmentClick="() => _show = !_show"
              Validation="@(new Func<string, string?>(ValidatePassword))" UserAttributes="@PasswordAttributes" />
<MudStack Spacing="1">
    <MudProgressLinear Value="@Score" Max="3" Color="@ScoreColor" Rounded />
    <MudText Typo="Typo.caption">@L["SetupPasswordStrength", L[ScoreKey]]</MudText>
</MudStack>
<MudTextField T="string" @bind-Value="_repeat" Label="@L["SetupPasswordRepeat"]" Variant="Variant.Outlined"
              InputType="@(_show ? InputType.Text : InputType.Password)" Immediate
              Validation="@(new Func<string, string?>(ValidateRepeat))" UserAttributes="@RepeatAttributes" />

@code {
    private static readonly Dictionary<string, object> PasswordAttributes = new() { ["autocomplete"] = "new-password", ["data-testid"] = "new-password" };
    private static readonly Dictionary<string, object> RepeatAttributes = new() { ["autocomplete"] = "new-password", ["data-testid"] = "new-password-repeat" };
    private bool _show;
    private string _repeat = string.Empty;

    [Parameter] public string Password { get; set; } = string.Empty;

    [Parameter] public EventCallback<string> PasswordChanged { get; set; }

    [Parameter] public string? Label { get; set; }

    [Parameter] public bool AutoFocus { get; set; }

    /// <summary>Stärke 0–3: leer, zu kurz, ausreichend, stark.</summary>
    public static int Rate(string? password)
    {
        password ??= string.Empty;
        if (password.Length < SetupLimits.MinPasswordLength)
        {
            return password.Length == 0 ? 0 : 1;
        }

        var classes = new[] { password.Any(char.IsLower), password.Any(char.IsUpper), password.Any(char.IsDigit), password.Any(c => !char.IsLetterOrDigit(c)) }.Count(x => x);
        return password.Length >= 20 || (password.Length >= 16 && classes >= 3) ? 3 : 2;
    }

    /// <summary>Leert die Wiederholung, etwa nach erfolgreichem Speichern.</summary>
    public void Reset() => _repeat = string.Empty;

    private int Score => Rate(Password);

    private Color ScoreColor => Score switch { 3 => Color.Success, 2 => Color.Warning, _ => Color.Error };

    private string ScoreKey => Score switch { 3 => "SetupPasswordStrengthStrong", 2 => "SetupPasswordStrengthFair", _ => "SetupPasswordStrengthWeak" };

    private async Task OnPasswordChanged(string value)
    {
        Password = value;
        await PasswordChanged.InvokeAsync(value);
    }

    private string? ValidatePassword(string value) =>
        (value?.Length ?? 0) < SetupLimits.MinPasswordLength ? L["SetupPasswordTooShort", SetupLimits.MinPasswordLength].Value : null;

    private string? ValidateRepeat(string value) => value == Password ? null : L["SetupPasswordMismatch"].Value;
}
