@* Checkliste nach Phasen (M3.2): Aufgaben mit Beschreibung, Zuständigkeit, verknüpften Einträgen und gemeinsamem
   Abhaken. Für den Eigentümer (Seite „Checkliste“) und im Lesemodus. *@
@using System.Globalization
@using MyLife.Shared.Checklist
@inject IStringLocalizer<SharedResource> L
@inject SchemaText Text

<MudStack Spacing="4" data-testid="checklist">
    @foreach (var phase in ChecklistService.ByPhase(Tasks))
    {
        <MudStack Spacing="2">
            <MudText Typo="Typo.h6" HtmlTag="h3">@Text.Option("checklistPhase", phase.Key)</MudText>
            @foreach (var task in phase)
            {
                var done = Progress.FirstOrDefault(p => p.TaskId == task.Id);
                var linked = ChecklistService.Linked(task, Items);
                var area = ChecklistService.LinkedArea(task);
                var wish = ChecklistService.LinkedWish(task);
                <MudPaper Outlined Class="@($"pa-3 {(done is null ? string.Empty : "mylife-task-done")}")" data-testid="checklist-task">
                    <MudStack Row AlignItems="AlignItems.Start" Spacing="2">
                        <MudCheckBox T="bool" Value="done is not null" ValueChanged="v => ToggleAsync(task, v)" Disabled="_busy || !CanTick"
                                     Color="Color.Primary" aria-label="@L["ChecklistDone"]" data-testid="checklist-tick" />
                        <MudStack Spacing="1" Style="flex: 1; min-width: 0;">
                            @if (ObjectLinks)
                            {
                                <MudLink Href="@($"object/{task.Id}")" Typo="Typo.subtitle1" Color="Color.Inherit"><b>@task.Title</b></MudLink>
                            }
                            else
                            {
                                <MudText Typo="Typo.subtitle1"><b>@task.Title</b></MudText>
                            }
                            @if (task.Payload.Get("taskText") is { Length: > 0 } description)
                            {
                                <MudText Typo="Typo.body2" Class="mylife-multiline">@description</MudText>
                            }
                            @if (task.Payload.Get("responsible") is { Length: > 0 } responsible)
                            {
                                <MudText Typo="Typo.body2" Class="mylife-muted">@L["ChecklistResponsible", responsible]</MudText>
                            }
                            @if (area is { } a)
                            {
                                <MudStack Row AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="1">
                                    <MudText Typo="Typo.body2" Class="mylife-muted">
                                        @(wish is null ? L["ChecklistLinkedArea", Text.Area(a)] : L["ChecklistLinkedAreaWish", Text.Area(a), Text.Wish(wish)])
                                    </MudText>
                                    @if (CanOpenArea?.Invoke(a) == true)
                                    {
                                        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="() => OnOpenArea.InvokeAsync(a)" data-testid="checklist-open-area">@L["ChecklistOpenArea"]</MudButton>
                                    }
                                </MudStack>
                            }
                            @if (linked.Count > 0)
                            {
                                <MudStack Row Wrap="Wrap.Wrap" Spacing="1" data-testid="checklist-linked">
                                    @foreach (var item in linked)
                                    {
                                        @if (ObjectLinks)
                                        {
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Href="@($"object/{item.Id}")">@item.Title</MudChip>
                                        }
                                        else
                                        {
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@item.Title</MudChip>
                                        }
                                    }
                                </MudStack>
                            }
                            @if (done is not null)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Success" data-testid="checklist-done-by">
                                    @L["ChecklistDoneBy", done.DoneByName, done.DoneAt.ToLocalTime().ToString("g", CultureInfo.CurrentCulture)]
                                </MudText>
                            }
                        </MudStack>
                    </MudStack>
                </MudPaper>
            }
        </MudStack>
    }
</MudStack>

@code {
    private bool _busy;

    [Parameter, EditorRequired] public IEnumerable<VaultItem> Tasks { get; set; } = [];

    /// <summary>Einträge, unter denen verknüpfte gesucht werden (was nicht dabei ist, wird nicht gezeigt).</summary>
    [Parameter] public IEnumerable<VaultItem> Items { get; set; } = [];

    [Parameter] public IReadOnlyList<ChecklistProgressDto> Progress { get; set; } = [];

    [Parameter] public bool CanTick { get; set; } = true;

    /// <summary>Titel verlinken auf die Seite des Eintrags (nur der Eigentümer).</summary>
    [Parameter] public bool ObjectLinks { get; set; }

    [Parameter] public Func<int, bool>? CanOpenArea { get; set; }

    [Parameter] public EventCallback<int> OnOpenArea { get; set; }

    /// <summary>Abhaken (true) oder zurücknehmen (false); der Aufrufer spricht mit dem Server und aktualisiert <see cref="Progress"/>.</summary>
    [Parameter] public Func<VaultItem, bool, Task>? OnToggle { get; set; }

    private async Task ToggleAsync(VaultItem task, bool done)
    {
        if (OnToggle is null)
        {
            return;
        }

        _busy = true;
        try
        {
            await OnToggle(task, done);
        }
        finally
        {
            _busy = false;
        }
    }
}
