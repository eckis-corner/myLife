@* Leitet nicht angemeldete Aufrufe geschützter Seiten zur Anmeldung um und merkt sich die Zielseite. *@
@inject NavigationManager Navigation

@code {
    protected override void OnInitialized()
    {
        var target = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
        Navigation.NavigateTo(target is "/" or "/login" ? "login" : $"login?returnUrl={Uri.EscapeDataString(target)}");
    }
}
