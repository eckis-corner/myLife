@* Passwort für ein PDF (Notfallordner, Datenblatt). Leer lassen erzeugt ein PDF ohne Schutz, nach ausdrücklicher Bestätigung. *@
@inject IStringLocalizer<SharedResource> L

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@L["PdfPasswordTitle"]</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudText Typo="Typo.body2">@L["PdfPasswordText"]</MudText>
            <MudTextField T="string" @bind-Value="_password" Label="@L["PdfPassword"]" Variant="Variant.Outlined" InputType="InputType.Password" HelperText="@L["PdfPasswordHelp"]"
                          Immediate Error="@(!IsAscii)" ErrorText="@L["PdfPasswordAscii"]" UserAttributes="@NewPassword" />
            <MudTextField T="string" @bind-Value="_repeat" Label="@L["SetupPasswordRepeat"]" Variant="Variant.Outlined" InputType="InputType.Password"
                          Immediate Error="@Mismatch" ErrorText="@L["SetupPasswordMismatch"]" UserAttributes="@NewPassword" />
            @if (string.IsNullOrEmpty(_password))
            {
                <MudCheckBox T="bool" @bind-Value="_withoutPassword" Label="@L["PdfWithoutPassword"]" Color="Color.Warning" />
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="!CanCreate" OnClick="Create" data-testid="pdf-create">@L["PdfCreate"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private static readonly Dictionary<string, object> NewPassword = new() { ["autocomplete"] = "new-password" };
    private string _password = string.Empty;
    private string _repeat = string.Empty;
    private bool _withoutPassword;

    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    private bool Mismatch => _repeat.Length > 0 && _repeat != _password;

    // Nur druckbares ASCII: Umlaute kodieren PDF-Programme unterschiedlich (Apple Vorschau zerlegt sie, entgegen der Norm).
    private bool IsAscii => _password.All(c => c is >= ' ' and <= '~');

    private bool CanCreate => string.IsNullOrEmpty(_password) ? _withoutPassword : _password.Length >= 8 && IsAscii && _password == _repeat;

    private void Cancel() => Dialog.Cancel();

    // Ergebnis: das Passwort, leer für ein PDF ohne Schutz.
    private void Create() => Dialog.Close(DialogResult.Ok(_password));
}
