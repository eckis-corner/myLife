@* Formular aus dem Objekttyp-Schema (Architektur 6.2): die Felder des Katalogs aus MyCommon.Ui (144), dazu die gemeinsamen
   Angaben von myLife. Bearbeitet die übergebene Nutzlast direkt; geprüft wird beim Speichern. *@
@inject IStringLocalizer<SharedResource> L
@inject SchemaText Text
@inject VaultService Vault

<MudStack Spacing="3">
    @if (Managed)
    {
        @* Schreibschutz (59, 168): Diese Angaben pflegt myDocs; hier bleiben nur die eigenen Angaben von myLife. *@
        <MudAlert Severity="Severity.Info" Dense Icon="@Icons.Material.Outlined.Sync" data-testid="form-managed">@L["MyDocsManagedHint"]</MudAlert>
        <MudTextField T="string" Value="Payload.Title" Label="@L["CommonTitle"]" Variant="Variant.Outlined" ReadOnly UserAttributes="@TitleAttributes" />
    }
    else
    {
        <MudTextField T="string" Value="Payload.Title" ValueChanged="v => Payload.Title = v ?? string.Empty" Label="@L["CommonTitle"]"
                      Variant="Variant.Outlined" Required MaxLength="200" Error="@Has("title")" ErrorText="@ErrorOf("title")"
                      UserAttributes="@TitleAttributes" />

        <CatalogFields Type="Type" Values="Payload" Errors="Errors" Choices="Choices">
            <LocationField Context="place">
                <LocationPicker Payload="Payload" Key="@place.Field.Key" Label="@place.Label" Required="place.Required" Error="@place.Error"
                                ErrorText="@place.ErrorText" HelperText="@place.HelperText" />
            </LocationField>
        </CatalogFields>
    }

    <MudText Typo="Typo.subtitle1" HtmlTag="h3" Class="mt-2"><b>@L["CommonSection"]</b></MudText>
    <MudGrid Spacing="2">
        <MudItem xs="12" sm="6">
            <MudDatePicker Label="@Text.Expiry(Type)" Date="@ToDateTime(Payload.ExpiresOn)" DateChanged="d => Payload.ExpiresOn = ToDateOnly(d)"
                           Variant="Variant.Outlined" Editable="!Managed" ReadOnly="Managed" Clearable="!Managed" HelperText="@L["CommonExpiryHelp"]" />
        </MudItem>
        <MudItem xs="12" sm="6">
            <LocationPicker Payload="Payload" Key="@VaultPayload.OriginalLocationKey" Label="@L["CommonOriginalLocation"]"
                            Required="Type.OriginalLocationRequired" Error="@Has(VaultPayload.OriginalLocationKey)"
                            ErrorText="@ErrorOf(VaultPayload.OriginalLocationKey)" />
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudSelect T="Guid?" Value="Payload.ContactId" ValueChanged="v => Payload.ContactId = v" Label="@L["CommonContact"]"
                       Variant="Variant.Outlined" Clearable>
                @foreach (var contact in Options(["contact"]))
                {
                    <MudSelectItem T="Guid?" Value="@contact.Id">@contact.Title</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        @if (Type.Wishes.Count > 0)
        {
            <MudItem xs="12" sm="6">
                <MudSelect T="string" Value="Payload.Wish" ValueChanged="v => Payload.Wish = v" Label="@L["CommonWish"]" Variant="Variant.Outlined" Clearable>
                    @foreach (var wish in Type.Wishes)
                    {
                        <MudSelectItem T="string" Value="@wish">@Text.Wish(wish)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        }
        <MudItem xs="12">
            <MudTextField T="string" @bind-Value="Payload.WishNote" Label="@L["CommonWishNote"]" Variant="Variant.Outlined" Lines="2" Sizing="InputSizing.Auto"
                          HelperText="@L["CommonWishNoteHelp"]" MaxLength="@FieldValues.MaxLongTextLength" />
        </MudItem>
        <MudItem xs="12">
            <MudSelect T="Guid" SelectedValues="Payload.Links" SelectedValuesChanged="v => Payload.Links = [.. v]" MultiSelection
                       Label="@L["CommonLinks"]" HelperText="@L["CommonLinksHelp"]" Variant="Variant.Outlined" Clearable
                       ToStringFunc="@(id => Vault.TitleOf(id) ?? string.Empty)">
                @foreach (var other in Options([]).Where(o => o.Type.Key != ObjectCatalog.LocationType))
                {
                    <MudSelectItem T="Guid" Value="@other.Id">@other.Title (@Text.Type(other.Type))</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudDatePicker Label="@L["CommonFollowUpOn"]" Date="@ToDateTime(Payload.FollowUpOn)" DateChanged="d => Payload.FollowUpOn = ToDateOnly(d)"
                           Variant="Variant.Outlined" Editable Clearable HelperText="@L["CommonFollowUpHelp"]" />
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudTextField T="string" Value="Payload.FollowUpNote" ValueChanged="v => Payload.FollowUpNote = string.IsNullOrWhiteSpace(v) ? null : v"
                          Label="@L["CommonFollowUpNote"]" Variant="Variant.Outlined" Sizing="InputSizing.Auto" MaxLength="@FieldValues.MaxLongTextLength"
                          Error="@Has("followUpNote")" ErrorText="@ErrorOf("followUpNote")" UserAttributes="@FollowUpNoteAttributes" />
        </MudItem>
        <MudItem xs="12">
            <MudTextField T="string" @bind-Value="Payload.Notes" Label="@L["CommonNotes"]" Variant="Variant.Outlined" Lines="3" Sizing="InputSizing.Auto"
                          MaxLength="@FieldValues.MaxLongTextLength" />
        </MudItem>
    </MudGrid>

    <MudText Typo="Typo.subtitle1" HtmlTag="h3" Class="mt-2"><b>@L["CommonCustomFields"]</b></MudText>
    @for (var i = 0; i < Payload.CustomFields.Count; i++)
    {
        var index = i;
        var custom = Payload.CustomFields[index];
        <MudStack Row AlignItems="AlignItems.Start" Spacing="2">
            <MudTextField T="string" Value="custom.Label" ValueChanged="v => Payload.CustomFields[index] = Payload.CustomFields[index] with { Label = v ?? string.Empty }"
                          Label="@L["CommonCustomLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="100" Style="max-width: 16rem" />
            <MudTextField T="string" Value="custom.Value" ValueChanged="v => Payload.CustomFields[index] = Payload.CustomFields[index] with { Value = v ?? string.Empty }"
                          Label="@L["CommonCustomValue"]" Variant="Variant.Outlined" Margin="Margin.Dense" Sizing="InputSizing.Auto" MaxLength="@FieldValues.MaxLongTextLength" />
            <MudTooltip Text="@L["Delete"]">
                <MudIconButton Icon="@Icons.Material.Outlined.Delete" Color="Color.Error" aria-label="@L["Delete"]" Class="mt-2"
                               OnClick="() => Payload.CustomFields.RemoveAt(index)" />
            </MudTooltip>
        </MudStack>
    }
    <div>
        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => Payload.CustomFields.Add(new CustomField(string.Empty, string.Empty)))">
            @L["CommonAddCustomField"]
        </MudButton>
    </div>
</MudStack>

@code {
    private static readonly Dictionary<string, object> TitleAttributes = new() { ["data-testid"] = "object-title" };
    private static readonly Dictionary<string, object> FollowUpNoteAttributes = new() { ["data-testid"] = "follow-up-note" };

    [Parameter, EditorRequired] public ObjectTypeDefinition Type { get; set; } = default!;

    [Parameter, EditorRequired] public VaultPayload Payload { get; set; } = default!;

    /// <summary>ID des bearbeiteten Objekts (wird bei Verweisen ausgeschlossen).</summary>
    [Parameter] public Guid? ObjectId { get; set; }

    [Parameter] public IReadOnlyDictionary<string, string> Errors { get; set; } = new Dictionary<string, string>();

    /// <summary>Mit myDocs verknüpft (168): Titel, Katalogfelder und Ablaufdatum sind schreibgeschützt.</summary>
    private bool Managed => Payload.MyDocs is not null;

    private bool Has(string key) => Errors.ContainsKey(key);

    private string? ErrorOf(string key) => Errors.TryGetValue(key, out var code) ? Text.Error(code) : null;

    private IEnumerable<VaultItem> Options(IReadOnlyList<string> types) => Vault.Current
        .Where(i => i.Id != ObjectId && (types.Count == 0 || types.Contains(i.Type.Key)))
        .OrderBy(i => i.Title, StringComparer.CurrentCultureIgnoreCase);

    private static DateTime? ToDateTime(DateOnly? date) => date?.ToDateTime(TimeOnly.MinValue);

    private static DateOnly? ToDateOnly(DateTime? date) => date is { } d ? DateOnly.FromDateTime(d) : null;

    private IEnumerable<ObjectChoice> Choices(IReadOnlyList<string> types) => Options(types).Select(i => new ObjectChoice(i.Id, i.Title, i.Type.Key));
}
