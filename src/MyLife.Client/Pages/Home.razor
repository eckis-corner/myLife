@page "/"
@attribute [Authorize]
@inherits VaultPageBase
@using System.Globalization
@inject IStringLocalizer<SharedResource> L
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject ReminderSync Reminders

<PageTitle>@L["AppName"] – @L["NavHome"]</PageTitle>

<MudStack Spacing="4">
    <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
        <MudText Typo="Typo.h4" HtmlTag="h1">@L["HomeTitle"]</MudText>
        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.Search" Href="search">@L["NavSearch"]</MudButton>
    </MudStack>

    <EmergencyBanner />

    @if (Loading)
    {
        <MudProgressLinear Indeterminate Color="Color.Primary" />
    }
    else if (LoadFailed)
    {
        <MudAlert Severity="Severity.Error">@L["VaultLoadFailed"]</MudAlert>
    }
    else
    {
        @if (Vault.UnreadableCount > 0)
        {
            <MudAlert Severity="Severity.Warning">@L["VaultUnreadable", Vault.UnreadableCount]</MudAlert>
        }

        @if (_dueAreas.Count > 0)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" data-testid="review-due">
                @L["HomeReviewDue", _dueAreas.Count, Reminders.Settings.ReviewMonths]
                <MudLink Href="account/reminders" Class="ml-1">@L["RemindersTitle"]</MudLink>
            </MudAlert>
        }

        @if (_followUps.Count > 0)
        {
            <MudPaper Class="pa-4" Elevation="1" data-testid="follow-ups">
                <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-2">@L["HomeFollowUpTitle"]</MudText>
                <MudList T="string" Dense ReadOnly="false">
                    @foreach (var item in _followUps)
                    {
                        var due = item.Payload.IsFollowUpDue(_today);
                        <MudListItem T="string" Icon="@Icons.Material.Outlined.EventRepeat" IconColor="@(due ? Color.Warning : Color.Default)"
                                     OnClick="@(() => Navigation.NavigateTo($"object/{item.Id}"))">
                            <b>@item.Title</b> · @SchemaText.FollowUp(item.Payload)
                            @if (due)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined" Class="ml-2">@L["FollowUpDue"]</MudChip>
                            }
                        </MudListItem>
                    }
                </MudList>
            </MudPaper>
        }

        @if (_expiring.Count > 0)
        {
            <MudPaper Class="pa-4" Elevation="1">
                <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-2">@L["HomeExpiringTitle"]</MudText>
                <MudList T="string" Dense ReadOnly="false">
                    @foreach (var item in _expiring)
                    {
                        <MudListItem T="string" Icon="@Icons.Material.Outlined.Event" OnClick="@(() => Navigation.NavigateTo($"object/{item.Id}"))">
                            <b>@item.Title</b> · @Text.Expiry(item.Type): @item.Payload.ExpiresOn!.Value.ToString("d", CultureInfo.CurrentCulture)
                        </MudListItem>
                    }
                </MudList>
            </MudPaper>
        }

        <MudGrid Spacing="3">
            @foreach (var area in ObjectCatalog.Areas.Where(a => a.IsAvailable))
            {
                var state = _states.GetValueOrDefault(area.Number);
                var count = _counts.GetValueOrDefault(area.Number);
                var href = area.Number == ObjectCatalog.ChecklistArea ? "checklist" : $"area/{area.Number}";
                <MudItem xs="12" sm="6" md="4">
                    <MudCard Elevation="1" Class="mylife-area-card" data-testid="@($"area-tile-{area.Number}")">
                        <MudCardHeader>
                            <CardHeaderAvatar>
                                <MudAvatar Color="Color.Primary" Variant="Variant.Outlined"><MudIcon Icon="@AreaIcons.For(area.Number)" /></MudAvatar>
                            </CardHeaderAvatar>
                            <CardHeaderContent>
                                <MudLink Href="@href" Typo="Typo.subtitle1" Color="Color.Inherit"><b>@Text.Area(area.Number)</b></MudLink>
                                <MudText Typo="Typo.body2" Class="mylife-muted">@L["HomeObjectCount", count]</MudText>
                                @if (_dueAreas.Contains(area.Number))
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined" data-testid="@($"area-review-due-{area.Number}")">
                                        @L["HomeReviewDueChip"]
                                    </MudChip>
                                }
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent Class="pt-0">
                            <MudText Typo="Typo.caption" Class="mylife-muted">
                                @(state?.LastReviewedAt is { } reviewed
                                    ? L["HomeLastReviewed", reviewed.ToLocalTime().ToString("d", CultureInfo.CurrentCulture)]
                                    : L["HomeNeverReviewed"])
                            </MudText>
                        </MudCardContent>
                        <MudCardActions>
                            <MudButton Variant="Variant.Text" Href="@href">@L["Open"]</MudButton>
                            <MudSpacer />
                            <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.TaskAlt" Disabled="_busy"
                                       OnClick="() => MarkReviewedAsync(area.Number)" data-testid="@($"area-reviewed-{area.Number}")">
                                @L["HomeMarkReviewed"]
                            </MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>

        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense>
            @L["HomeNotInVaultHint"] <MudLink Href="hints/not-in-vault">@L["NotInVaultTitle"]</MudLink>
        </MudAlert>
    }
</MudStack>

@code {
    /// <summary>Wiedervorlagen, die in so vielen Tagen fällig werden, stehen schon auf dem Dashboard.</summary>
    private const int FollowUpDays = 14;

    private Dictionary<int, AreaState> _states = [];
    private IReadOnlySet<int> _dueAreas = new HashSet<int>();
    private Dictionary<int, int> _counts = [];
    private List<VaultItem> _expiring = [];
    private List<VaultItem> _followUps = [];
    private DateOnly _today;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        try
        {
            await Reminders.LoadAsync();
        }
        catch (Exception exception) when (exception is HttpRequestException or System.Text.Json.JsonException)
        {
            // Ohne die eigenen Einstellungen gelten die Standardwerte.
        }

        if (Vault.IsLoaded)
        {
            OnVaultReady();
        }
    }

    protected override void OnVaultReady()
    {
        _dueAreas = Reminders.DueAreas(DateTimeOffset.Now);
        _states = Vault.Areas.ToDictionary(a => a.Area);
        _counts = Vault.Current.Where(i => i.Status == ObjectStatus.Active).GroupBy(i => i.Area).ToDictionary(g => g.Key, g => g.Count());
        var today = _today = DateOnly.FromDateTime(DateTime.Today);
        _followUps = [.. Vault.Current
            .Where(i => i.Status == ObjectStatus.Active && i.Payload.FollowUpOn is { } f && f <= today.AddDays(FollowUpDays))
            .OrderBy(i => i.Payload.FollowUpOn)
            .Take(20)];
        _expiring = [.. Vault.Current
            .Where(i => i.Status == ObjectStatus.Active && i.Payload.ExpiresOn is { } e && e <= today.AddDays(Reminders.Settings.LeadDays))
            .OrderBy(i => i.Payload.ExpiresOn)
            .Take(10)];
    }

    private async Task MarkReviewedAsync(int area)
    {
        _busy = true;
        try
        {
            await Vault.MarkAreaReviewedAsync(area);
            Snackbar.Add(L["HomeReviewedSaved", Text.Area(area)], Severity.Success);
        }
        catch (Exception exception) when (exception is VaultException or HttpRequestException)
        {
            Snackbar.Add(L[$"VaultError_{VaultErrors.Failed}"], Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}
