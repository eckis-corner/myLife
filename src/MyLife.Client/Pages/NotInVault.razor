@page "/hints/not-in-vault"
@attribute [Authorize]
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["AppName"] – @L["NotInVaultTitle"]</PageTitle>

<MudStack Spacing="3">
    <MudText Typo="Typo.h4" HtmlTag="h1">@L["NotInVaultTitle"]</MudText>
    <NotInVaultHint />
    <MudPaper Class="pa-4" Elevation="1">
        <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-2">@L["NotInVaultChecksTitle"]</MudText>
        <MudText Typo="Typo.body2">@L["NotInVaultChecksText"]</MudText>
        <MudList T="string" Dense ReadOnly>
            <MudListItem Icon="@Icons.Material.Outlined.CreditCard">@L["ContentWarning_card-number"]</MudListItem>
            <MudListItem Icon="@Icons.Material.Outlined.Pin">@L["ContentWarning_secret"]</MudListItem>
            <MudListItem Icon="@Icons.Material.Outlined.CurrencyBitcoin">@L["ContentWarning_seed-phrase"]</MudListItem>
        </MudList>
    </MudPaper>
</MudStack>
