@inherits LayoutComponentBase
@inject IStringLocalizer<SharedResource> L
@inject NavigationManager Navigation
@inject Microsoft.JSInterop.IJSRuntime JS

@* Lesemodus (Architektur 1.4, M2.5): ruhig und linear, ohne Seitenleiste und Verwaltung, große Schrift. *@
<MudThemeProvider @ref="_themeProvider" Theme="_theme" @bind-IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<IdleMonitor />

<a class="mylife-skip-link" href="@SkipTarget">@L["SkipToContent"]</a>

<MudLayout Class="@($"mylife-rixio {(_isDarkMode ? "mylife-rixio-dark" : "mylife-rixio-light")} mylife-reading-mode {(_large ? "mylife-reading-large" : string.Empty)}")">
    <MudAppBar Elevation="0" Class="mylife-appbar">
        <AppLogo InAppBar />
        <MudText Typo="Typo.subtitle1" Class="ml-3 d-none d-sm-flex">@L["ReadingTitle"]</MudText>
        <MudSpacer />
        <MudTooltip Text="@L[_large ? "ReadingFontNormal" : "ReadingFontLarge"]">
            <MudIconButton Icon="@(_large ? Icons.Material.Filled.TextDecrease : Icons.Material.Filled.TextIncrease)" Color="Color.Inherit"
                           aria-label="@L[_large ? "ReadingFontNormal" : "ReadingFontLarge"]" OnClick="() => _large = !_large" data-testid="reading-font" />
        </MudTooltip>
        <MudButton Variant="Variant.Text" Color="Color.Inherit" Href="./" StartIcon="@Icons.Material.Outlined.ExitToApp" data-testid="reading-leave">@L["ReadingLeave"]</MudButton>
    </MudAppBar>
    <MudMainContent Class="mylife-main" role="main">
        <MudContainer MaxWidth="MaxWidth.Medium" Class="py-6" id="main-content" tabindex="-1">
            <ErrorBoundary>
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent>
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
                        @L["ErrorUnhandled"]
                        <MudButton Variant="Variant.Text" Color="Color.Error" Href="reading" Class="ml-2">@L["Reload"]</MudButton>
                    </MudAlert>
                </ErrorContent>
            </ErrorBoundary>
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private readonly MudTheme _theme = Theme.MyLifeTheme.Create();
    private MudThemeProvider? _themeProvider;
    private bool _isDarkMode;
    private bool _large = true;

    private bool? _appliedLight;

    private string SkipTarget => $"{Navigation.Uri.Split('#')[0]}#main-content";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _themeProvider is not null)
        {
            _isDarkMode = await _themeProvider.GetSystemDarkModeAsync();
            StateHasChanged();
        }

        if (_appliedLight != !_isDarkMode)
        {
            _appliedLight = !_isDarkMode;
            await JS.InvokeVoidAsync("myLife.setLightMode", !_isDarkMode);
        }
    }
}
