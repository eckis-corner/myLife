@inherits LayoutComponentBase
@inject IStringLocalizer<SharedResource> L
@* Dienste optional: Die Seite „nicht gefunden“ rendert der Server statisch mit diesem Layout, ohne die Dienste des Browsers. *@
@inject IServiceProvider ServiceProvider
@implements IDisposable

<MudThemeProvider @ref="_themeProvider" Theme="_theme" @bind-IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<IdleMonitor />

@* Design nach dem rixio-Template (Entscheidung 71): flache Kopfzeile mit Trennlinie, Seitenleiste mit Orange-Akzent. *@
<a class="mylife-skip-link" href="@SkipTarget">@L["SkipToContent"]</a>

<MudLayout Class="@(_isDarkMode ? "mylife-rixio mylife-rixio-dark" : "mylife-rixio mylife-rixio-light")">
    <MudAppBar Elevation="0" Class="mylife-appbar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       aria-label="@L["OpenMenu"]"
                       OnClick="ToggleDrawer" />
        <AppLogo InAppBar />
        <MudSpacer />
        <LanguageMenu />
        <UserMenu />
        <MudTooltip Text="@L["ToggleDarkMode"]">
            <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                           Color="Color.Inherit"
                           aria-label="@L["ToggleDarkMode"]"
                           OnClick="() => _isDarkMode = !_isDarkMode" />
        </MudTooltip>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="0" Variant="DrawerVariant.Responsive" Class="mylife-drawer">
        <AuthorizeView>
            <Authorized>
                @* Hauptmenü scrollt; Verwaltung, Hilfe und Konto stehen immer sichtbar am unteren Rand der Seitenleiste. *@
                <div class="mylife-drawer-body">
                <MudNavMenu Class="mylife-nav mylife-nav-main">
                    <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Dashboard">@L["NavHome"]</MudNavLink>
                    <MudNavLink Href="search" Icon="@Icons.Material.Outlined.Search">@L["NavSearch"]</MudNavLink>
                    <MudNavGroup Title="@L["NavAreas"]" Icon="@Icons.Material.Outlined.FolderOpen" Expanded>
                        @foreach (var area in MyLife.Shared.Vault.ObjectCatalog.Areas.Where(a => a.IsAvailable))
                        {
                            <MudNavLink Href="@(area.Number == MyLife.Shared.Vault.ObjectCatalog.ChecklistArea ? "checklist" : $"area/{area.Number}")" Icon="@AreaIcons.For(area.Number)">@L[$"Area_{area.Number}"]</MudNavLink>
                        }
                    </MudNavGroup>
                    <MudNavLink Href="family" Icon="@Icons.Material.Outlined.Diversity3">@L["FamilyTitle"]</MudNavLink>
                    <MudNavLink Href="trust" Icon="@Icons.Material.Outlined.VolunteerActivism">@L["TrustTitle"]</MudNavLink>
                    <MudNavLink Href="shared" Icon="@Icons.Material.Outlined.FolderShared">@L["SharedTitle"]</MudNavLink>
                    <MudNavLink Href="emergency" Icon="@Icons.Material.Outlined.HealthAndSafety">@L["EmergencyTitle"]</MudNavLink>
                    <MudNavLink Href="reading" Icon="@Icons.Material.Outlined.MenuBook">@L["ReadingTitle"]</MudNavLink>
                    <MudNavLink Href="export" Icon="@Icons.Material.Outlined.IosShare">@L["NavExport"]</MudNavLink>
                </MudNavMenu>
                @* Unten immer sichtbar: Verwaltung, darunter Hilfe direkt über „Konto“ (Entscheidungen 139 und 140). *@
                <MudNavMenu Class="mylife-nav mylife-nav-account">
                    <MudNavGroup Title="@L["NavAdmin"]" Icon="@Icons.Material.Outlined.AdminPanelSettings" Expanded="false" data-testid="nav-admin">
                        <MudNavLink Href="account/audit" Icon="@Icons.Material.Outlined.History">@L["NavAudit"]</MudNavLink>
                        <MudNavLink Href="trash" Icon="@Icons.Material.Outlined.Delete">@L["NavTrash"]</MudNavLink>
                        @if (context.User.IsInRole("admin"))
                        {
                            <MudNavLink Href="admin/settings" Icon="@Icons.Material.Outlined.Settings">@L["AdminSettingsTitle"]</MudNavLink>
                            <MudNavLink Href="admin/users" Icon="@Icons.Material.Outlined.People">@L["AdminUsersTitle"]</MudNavLink>
                            <MudNavLink Href="admin/audit" Icon="@Icons.Material.Outlined.ReceiptLong">@L["AdminAuditTitle"]</MudNavLink>
                        }
                    </MudNavGroup>
                    <MudNavLink Href="tutorial" Icon="@Icons.Material.Outlined.RocketLaunch" data-testid="nav-tutorial">@L["NavTutorial"]</MudNavLink>
                    <MudNavLink Href="guide" Icon="@Icons.Material.Outlined.HelpOutline" data-testid="nav-guide">@L["NavGuide"]</MudNavLink>
                    <MudNavGroup Title="@L["NavAccount"]" Icon="@Icons.Material.Outlined.AccountCircle" Expanded="false" data-testid="nav-account">
                        <MudNavLink Href="account/reminders" Icon="@Icons.Material.Outlined.NotificationsActive">@L["RemindersTitle"]</MudNavLink>
                        <MudNavLink Href="account/security" Icon="@Icons.Material.Outlined.Security">@L["NavSecurity"]</MudNavLink>
                        <MudNavLink Href="account/profile" Icon="@Icons.Material.Outlined.Badge">@L["ProfileTitle"]</MudNavLink>
                        <MudNavLink Href="hints/not-in-vault" Icon="@Icons.Material.Outlined.Block">@L["NotInVaultTitle"]</MudNavLink>
                        <MudNavLink OnClick="LogoutAsync" Icon="@Icons.Material.Filled.Logout" data-testid="nav-logout">@L["Logout"]</MudNavLink>
                    </MudNavGroup>
                </MudNavMenu>
                </div>
            </Authorized>
        </AuthorizeView>
    </MudDrawer>

    <MudMainContent Class="mylife-main" role="main">
        <MudContainer MaxWidth="MaxWidth.Large" Class="py-6 flex-grow-1" id="main-content" tabindex="-1">
            <ErrorBoundary>
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent>
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
                        @L["ErrorUnhandled"]
                        <MudButton Variant="Variant.Text" Color="Color.Error" Href="." Class="ml-2">@L["Reload"]</MudButton>
                    </MudAlert>
                </ErrorContent>
            </ErrorBoundary>
        </MudContainer>
        <footer class="mylife-footer">
            <MudText Typo="Typo.caption">
                @L["AppName"]@if (_version is not null)
                {
                    <text> · @L["HomeStatusVersion"] @_version</text>
                } · <MudLink Href="privacy" Typo="Typo.caption" Color="Color.Inherit">@L["PrivacyTitle"]</MudLink>
            </MudText>
        </footer>
    </MudMainContent>
</MudLayout>

@code {
    private readonly MudTheme _theme = Theme.MyLifeTheme.Create();
    private MudThemeProvider? _themeProvider;
    private bool _isDarkMode;
    private bool _drawerOpen = true;
    private string? _version;

    private Guid? _syncedFor;

    protected override async Task OnInitializedAsync()
    {
        if (CurrentSession is not null)
        {
            CurrentSession.Changed += OnSessionChanged;
        }

        if (AppInfo is null)
        {
            return;
        }

        try
        {
            _version = (await AppInfo.GetAsync())?.Version;
        }
        catch (Exception)
        {
            // Die Versionsanzeige ist nur ein Hinweis; ohne Server bleibt die Fußzeile leer.
        }
    }

    private bool? _appliedLight;

    /// <summary>Sprunglink „Zum Inhalt“ auf die aktuelle Seite (mit &lt;base href="/"&gt; sonst die Startseite).</summary>
    private string SkipTarget => $"{(ServiceProvider.GetService<NavigationManager>()?.Uri ?? string.Empty).Split('#')[0]}#main-content";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _themeProvider is not null)
        {
            _isDarkMode = await _themeProvider.GetSystemDarkModeAsync();
            StateHasChanged();
        }

        if (_appliedLight != !_isDarkMode && ServiceProvider.GetService<Microsoft.JSInterop.IJSRuntime>() is { } js)
        {
            _appliedLight = !_isDarkMode;
            await js.InvokeVoidAsync("myLife.setLightMode", !_isDarkMode);
        }
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    /// <summary>Abmelden aus der Seitenleiste (Konto → Abmelden), wie im Menü der Kopfzeile.</summary>
    private async Task LogoutAsync()
    {
        if (CurrentSession is null)
        {
            return;
        }

        await CurrentSession.LogoutAsync();
        ServiceProvider.GetService<NavigationManager>()?.NavigateTo("login");
    }

    private AppInfoClient? AppInfo => ServiceProvider.GetService<AppInfoClient>();

    private SessionService? CurrentSession => ServiceProvider.GetService<SessionService>();

    private KeyTrustService? Trust => ServiceProvider.GetService<KeyTrustService>();

    public void Dispose()
    {
        if (CurrentSession is not null)
        {
            CurrentSession.Changed -= OnSessionChanged;
        }
    }

    /// <summary>
    /// Nach dem Entsperren prüft der Browser im Hintergrund angenommene Einladungen und gegenzeichnet gepinnte
    /// Schlüssel (Architektur 4.3: ohne Zutun der Nutzer). Einmal je Anmeldung.
    /// </summary>
    private void OnSessionChanged()
    {
        if (CurrentSession is not { State: SessionState.Unlocked, Session.UserId: var id } || _syncedFor == id)
        {
            return;
        }

        _syncedFor = id;
        _ = SyncTrustAsync();
    }

    private async Task SyncTrustAsync()
    {
        try
        {
            if (Trust is not null)
            {
                await Trust.SyncAsync();
            }
        }
        catch (Exception)
        {
            // Die Prüfung wiederholt sich beim nächsten Entsperren und auf der Seite „Familie“.
        }
    }
}
