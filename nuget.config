<?xml version="1.0" encoding="utf-8"?>
<!-- Paketquellen (Entscheidung 144): alles von nuget.org, MyCommon.* aus GitHub Packages von eckis-corner.
     GitHub Packages verlangt auch bei öffentlichen Paketen eine Anmeldung. Liegt my-common neben myLife,
     wird der Quellcode genutzt und diese Quelle nicht gebraucht. Sonst die Anmeldung über die Umgebungsvariable
     NuGetPackageSourceCredentials_eckiscorner="Username=<github-name>;Password=<token mit read:packages>". -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="eckiscorner" value="https://nuget.pkg.github.com/eckis-corner/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="eckiscorner">
      <package pattern="MyCommon.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
